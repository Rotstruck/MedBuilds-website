# ==============================================================================
# MEDBUILDS Environment Configuration Template
# Duplicate this file to `.env` or set these in your Vercel Project Settings:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# --- DATABASE (MongoDB Atlas or self-hosted) ---
# Optional: If not provided, demo requests operate in safe in-memory fallback mode
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
DB_NAME=medbuilds

# --- SMTP EMAIL CONFIGURATION ---
# Hostname of your SMTP provider:
# Gmail: smtp.gmail.com (port 587 or 465)
# Resend: smtp.resend.com (port 587, user: resend, pass: re_...)
# SendGrid: smtp.sendgrid.net (port 587, user: apikey, pass: SG...)
# Brevo (Sendinblue): smtp-relay.brevo.com (port 587)
# Mailgun: smtp.mailgun.org (port 587)
# AWS SES: email-smtp.<region>.amazonaws.com (port 587)
# Outlook / Office 365: smtp.office365.com (port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password-or-api-key

# Sender settings
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=MEDBUILDS by Rotstruck

# Lead alert recipient (where notifications of new demo requests are delivered)
SMTP_TO_EMAIL=sales@yourhospitaldomain.com

# SSL / TLS settings (optional, inferred automatically from port if omitted)
# Port 587 typically uses STARTTLS (SMTP_TLS=true)
# Port 465 typically uses SSL (SMTP_SSL=true)
SMTP_TLS=true
SMTP_SSL=false
SMTP_TIMEOUT=10.0

# --- FRONTEND CONFIGURATION ---
# Optional on Vercel (leave empty for same-domain deployments, or set if hosted separately)
# REACT_APP_BACKEND_URL=https://your-api-domain.com

# --- CORS SETTINGS ---
# Comma-separated list of allowed origins, or * for all
CORS_ORIGINS=*
