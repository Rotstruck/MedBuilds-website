{
  "name": "medbuilds-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MEDBUILDS by Rotstruck — Hospital Management & EMR Platform",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "cd frontend && npm install --legacy-peer-deps && DISABLE_ESLINT_PLUGIN=true npm run build",
    "start": "cd frontend && npm start",
    "install:frontend": "cd frontend && npm install --legacy-peer-deps",
    "install:backend": "pip install -r backend/requirements.txt"
  },
  "overrides": {
    "ajv": "^8.12.0",
    "ajv-formats": "^2.1.1",
    "ajv-keywords": "^5.1.0",
    "schema-utils": "^4.3.0",
    "fork-ts-checker-webpack-plugin": "^7.2.14"
  }
}
